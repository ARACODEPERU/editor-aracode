{
  "name": "@elmerrodriguez/editor-aracode",
  "version": "0.1.0",
  "description": "Editor de texto WYSIWYG ligero y moderno",
  "homepage": "https://github.com/ARACODEPERU/editor-aracode#readme",
  "bugs": {
    "url": "https://github.com/ARACODEPERU/editor-aracode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARACODEPERU/editor-aracode.git"
  },
  "license": "MIT",
  "author": "ARACODEPERU",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/aracode-editor.es.js",
      "require": "./dist/aracode-editor.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "main": "dist/aracode-editor.cjs",
  "directories": {
    "example": "examples"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.cjs",
    "prepare": "npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "html2pdf.js": "^0.10.2",
    "vite": "^5.4.0"
  },
  "optionalDependencies": {
    "html2pdf.js": "^0.10.2"
  },
  "module": "dist/aracode-editor.es.js",
  "unpkg": "dist/aracode-editor.umd.js"
}
